const ph=f=>{const d=document.createElement("div");d.className="ph";d.textContent="PLACEHOLDER: "+f+" (ganti dengan gambar yang sudah disensor)";return d};
const esc=t=>t.replace(/&/g,"&amp;").replace(/</g,"&lt;");
const g=$("#grid");
P.forEach((p,i)=>{
 const c=document.createElement("article");c.className="card";c.dataset.k=p.k;
 c.innerHTML=`<div class="top"><span>PROJECT ${p.no}</span><span class="badge ${p.k}">${p.st}</span></div><div class="body"><div class="im"></div><h3>${esc(p.t)}</h3><p class="cat">${esc(p.cat)}</p><p>${esc(p.d)}</p><p class="role"><b>My role:</b> ${esc(p.r)}</p><button class="btn" type="button" data-i="${i}">View details</button></div>`;
 const im=new Image();im.src=p.img;im.alt="Dokumentasi "+p.t;im.loading="lazy";im.onerror=()=>im.replaceWith(ph(p.img));
 c.querySelector(".im").append(im);g.append(c);
});
document.querySelectorAll(".filters button").forEach(b=>b.onclick=()=>{
 document.querySelectorAll(".filters button").forEach(x=>x.setAttribute("aria-pressed",x===b));
 g.querySelectorAll(".card").forEach(c=>c.hidden=!(b.dataset.f==="all"||c.dataset.k===b.dataset.f));
});
const dlg=$("#dlg");
g.addEventListener("click",e=>{
 const b=e.target.closest("button[data-i]");if(!b)return;
 const p=P[b.dataset.i];
 $("#dn").textContent="PROJECT "+p.no+" / "+p.st;
 let h=`<h2 id="dt">${esc(p.t)}</h2><p class="cat">${esc(p.cat)}</p>`;
 if(p.k==="team")h+=`<p class="note">Proyek tim. Bagian "My Contribution" menunjukkan kontribusi pribadi saya; hasil lain adalah milik tim.</p>`;
 L.forEach(l=>{
  if(!(l in p.s))return;const v=p.s[l];
  h+=`<h4>${l}</h4>`;
  if(v===null)h+=`<p class="todo">Placeholder: gambar, drawing, atau dokumen yang sudah disensor akan ditambahkan di sini.</p>`;
  else if(Array.isArray(v))h+="<ul>"+v.map(x=>`<li>${esc(x)}</li>`).join("")+"</ul>";
  else h+=`<p>${esc(v)}</p>`;
 });
 $("#db").innerHTML=h;dlg.showModal();dlg.scrollTop=0;
});
$("#cl").onclick=()=>dlg.close();
dlg.addEventListener("click",e=>{if(e.target===dlg)dlg.close()});
const links=[...document.querySelectorAll("nav a")];
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)links.forEach(a=>a.classList.toggle("on",a.hash==="#"+e.target.id))}),{rootMargin:"-40% 0px -55% 0px"});
document.querySelectorAll("main section").forEach(s=>io.observe(s));
</script>
</body>
</html>
